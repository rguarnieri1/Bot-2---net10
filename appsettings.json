{
  "CryptoExchange": {
    "Enabled": true,
    "PrimaryExchange": "crypto.com",
    "FallbackExchange": "bybit",
    "RateLimitDelayMs": 100,
    "APITimeout": 30
  },
  "TradingSettings": {
    "InitialCapital": 150.0,
    "RiskPercentPerTrade": 0.01,
    "RewardRiskRatio": 2.0,
    "MaxPositionSizePercent": 0.10,
    "MaxLeverage": 2.0,
    "CommissionsPercent": 0.8,
    "TaxRate": 0.26
  },
  "TradingStrategy": {
    "PrimaryStrategy": "SMA",
    "BackupStrategy": null,
    "EnableConfirmation": true,
    "ConfirmationMethod": "CandleStick"
  },
  "MarketMonitoring": {
    "CheckIntervalMinutes": 10,
    "MaxCryptosToAnalyze": 500,
    "TimeframeForCandlesticks": "4h",
    "CandlesPerAnalysis": 100,
    "MinCandlesForAnalysis": 50
  },
  "Notifications": {
    "EnableDesktopNotifications": true,
    "EnableEmailAlerts": true,
    "EmailSmtpServer": "smtp.gmail.com",
    "EmailSmtpPort": 587,
    "EmailAppPassword": "",
    "EmailAlertOnSignal": true,
    "EmailAlertOnTrade": true,
    "EmailAlertOnError": true,
    "EnableTradeLogging": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    },
    "LogsDirectory": "bin/Release/net8.0/Logs",
    "DataDirectory": "bin/Release/net8.0/Data"
  }
}
